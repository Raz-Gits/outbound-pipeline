# Copy to .env and fill in YOUR OWN keys. Every value below is a placeholder.
# Everything is optional: a provider with no key is skipped, and the cascade
# degrades to whatever is configured.

# --- verification (effectively free; the workhorse) ---
MAILTESTER_API_KEY=your-key-here

# --- free-quota finders, tried in this order ---
HUNTER_API_KEY=your-key-here
# HUNTER_API_KEY_2=optional-second-account
SNOV_API_ID=your-id-here
SNOV_API_SECRET=your-secret-here
GETPROSPECT_API_KEY=your-key-here
PROSPEO_API_KEY=your-key-here
TOMBA_API_KEY=your-key-here
TOMBA_API_SECRET=your-secret-here
# TOMBA_API_KEY_2= / TOMBA_API_SECRET_2=  optional second account

# --- paid, each behind its own explicit gate ---
# Anymail spends real money per valid hit. BOTH lines required:
# ENABLE_ANYMAIL=1
ANYMAIL_API_KEY=your-key-here
# ANYMAIL_MONTHLY_CAP=2000

# Apollo bills unpredictably (see providers/apollo.py). BOTH required:
# APOLLO_ENABLE=true
# APOLLO_API_KEY=your-key-here

# --- delivery ---
INSTANTLY_API_KEY=your-key-here
# Writes are additionally blocked unless this is set for the operation:
# INSTANTLY_ALLOW_WRITES=1

# --- optional egress proxy for the Hunter lane ---
# PROXY_URL=http://user:pass@proxy.example.com:8000
